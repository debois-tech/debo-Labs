# The domain that points at this server (an A record to its IP). Caddy gets the certificate for it.
LABS_DOMAIN=labs-api.example.com
# The origin(s) of the pages that may call this server, comma-separated, no trailing slash.
LAB_ALLOWED_ORIGINS=https://debo-labs.vercel.app
# Invite codes learners type before a lab starts, comma-separated. Revoke one by removing it.
LAB_ACCESS_TOKENS=change-me
# Optional: seats for the whole server, and its CPU and memory budget.
# MAX_SESSIONS=8
# LAB_CPUS=2.0
# LAB_MEMORY=2g
