{
  "name": "debo-labs",
  "version": "1.1.0",
  "private": true,
  "description": "Hands-on Linux, Git and AWS labs in a real terminal - run locally in Docker or hosted",
  "license": "MIT",
  "homepage": "https://github.com/debois-tech/debo-Labs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debois-tech/debo-Labs.git"
  },
  "bugs": {
    "url": "https://github.com/debois-tech/debo-Labs/issues"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-force-exit test/unit/*.test.js test/integration/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "lab:validate": "node scripts/validate-labs.js --strict",
    "lab:lint": "node scripts/lint-labs.js",
    "lab:check": "node scripts/lab-check.js",
    "lab:new": "node scripts/new-lab.js",
    "check:hygiene": "node scripts/check-hygiene.js",
    "readme:stats": "node scripts/readme-stats.js"
  },
  "dependencies": {
    "@vercel/sandbox": "^3.5.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jmespath": "^0.16.0",
    "js-yaml": "^5.4.2",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  }
}
